# UFS for the Alder Lake-N controller (8086:54ff).
#
# Built as modules, not built in. Talos v1.14 added UFS to its own kernel
# config as modules and listed the .ko files in hack/modules-amd64.txt; the
# imager installs every path in that list, so a built-in driver leaves it
# looking for files no build produces:
#
#   install: cannot stat '.../drivers/ufs/core/ufshcd-core.ko': No such file
#
# Upstream already carries SCSI_UFSHCD and SCSI_UFSHCD_PCI. The three below
# it does not set are the reason this fragment still exists.
CONFIG_SCSI_UFSHCD=m
CONFIG_SCSI_UFS_BSG=y
CONFIG_SCSI_UFSHCD_PCI=m
CONFIG_SCSI_UFS_DWC_TC_PCI=m
CONFIG_SCSI_UFSHCD_PLATFORM=m
